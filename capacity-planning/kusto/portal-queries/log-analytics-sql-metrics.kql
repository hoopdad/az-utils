// Run in: Azure Portal > Log Analytics workspace > Logs
// Requires: Diagnostic settings sending SQL metrics to Log Analytics
AzureMetrics
| where TimeGenerated > ago(30d)
| where ResourceProvider == "MICROSOFT.SQL"
| where MetricName in ("cpu_percent", "dtu_consumption_percent", "storage_percent")
| summarize
    avg_value = avg(Average),
    max_value = max(Maximum),
    p95_value = percentile(Average, 95)
    by Resource, MetricName, bin(TimeGenerated, 1d)
| order by Resource asc, MetricName asc, TimeGenerated asc
